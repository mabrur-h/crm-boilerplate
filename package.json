{
  "name": "crm-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run skills:check",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy && npm run db:migrate:remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply crm-boilerplate-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply crm-boilerplate-db --remote",
    "db:seed": "node scripts/seed.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "cf:setup": "node scripts/cf-setup.mjs",
    "r2:check": "node scripts/r2-check.mjs",
    "skills:update": "node scripts/update-skills.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/check-skills.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "better-auth": "1.7.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.45.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
