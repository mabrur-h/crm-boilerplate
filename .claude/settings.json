{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["cloudflare", "shadcn", "playwright"],
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run dev)",
      "Bash(npm run doctor)",
      "Bash(npm run setup)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:migrate:local)",
      "Bash(npm run db:seed)",
      "Bash(npm run skills:check)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(npm run deploy)",
      "Bash(npm run db:migrate:remote)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler d1 migrations apply:*)",
      "Bash(git push:*)",
      "Bash(npm run cf:setup:*)"
    ]
  }
}
